<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Temperatura de ruedas Maleño VIP</title>
<link rel="icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,700;0,800;1,800&family=Overpass:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{
  --noche:#061848; --marino:#132571; --rey:#0959C9; --cielo:#1BACE5; --bruma:#CAE0F3; --hielo:#EFF3F9;
  --tinta-marca:#132571; --cab:#FFFFFF; --banda:#061848; --banda-ink:#FFFFFF; --banda-mute:#B3C6E8;
  --paper:#F2F5FA; --card:#FFFFFF; --line:#D3DCE8; --line-2:#E6ECF4; --ink:#0F1B3D; --mute:#58658A;
  --go:#17794A; --go-bg:#DDF2E6; --go-dot:#2FA866; --warn:#8A5D00; --warn-dot:#E0A100; --warn-bg:#FFF2CC;
  --stop:#B42318; --stop-bg:#FDE3E0; --stop-dot:#D93A2B; --info:#0959C9; --info-bg:#E3EEFC; --focus:#0959C9; --activo:#132571;
  --gris-dot:#8090A6; --medida:#7FA3D6;
  --plate:#FFFFFF; --plate-ink:#0F1B3D; --plate-band:#0959C9;
  --shadow:0 1px 2px rgba(6,24,72,.07);
  --f-titulo:"Montserrat","Overpass",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --tinta-marca:#E7EDF9; --cab:#0D1738; --banda:#050F2E; --rey:#2F7BE6; --hielo:#121F48; --bruma:#1C2E66;
    --paper:#0A1230; --card:#111C40; --line:#27366C; --line-2:#1B2954; --ink:#E7EDF9; --mute:#9DAACB;
    --go:#5BC98D; --go-bg:#143323; --go-dot:#46B97A; --warn:#F2C55C; --warn-dot:#E8B030; --warn-bg:#3A2C0C;
    --stop:#FF8B80; --stop-bg:#3E1B1B; --stop-dot:#F0645A; --info:#6FA8F5; --info-bg:#16295A; --focus:#6FA8F5; --activo:#2F7BE6; --shadow:none;
    --gris-dot:#7B8AA8; --medida:#5E7FB8;
  }
}
:root[data-theme="dark"]{
  --tinta-marca:#E7EDF9; --cab:#0D1738; --banda:#050F2E; --rey:#2F7BE6; --hielo:#121F48; --bruma:#1C2E66;
  --paper:#0A1230; --card:#111C40; --line:#27366C; --line-2:#1B2954; --ink:#E7EDF9; --mute:#9DAACB;
  --go:#5BC98D; --go-bg:#143323; --go-dot:#46B97A; --warn:#F2C55C; --warn-dot:#E8B030; --warn-bg:#3A2C0C;
  --stop:#FF8B80; --stop-bg:#3E1B1B; --stop-dot:#F0645A; --info:#6FA8F5; --info-bg:#16295A; --focus:#6FA8F5; --activo:#2F7BE6; --shadow:none;
  --gris-dot:#7B8AA8; --medida:#5E7FB8;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.45 "Overpass",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  font-variant-numeric:tabular-nums}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
h1,h2,h3,p{margin:0}
[hidden]{display:none!important}
.wrap{max-width:1240px;margin:0 auto;padding:0 16px}

/* Cabecera corporativa */
.cab{background:var(--cab)}
.cab-in{display:grid;grid-template-columns:auto 1fr auto;gap:22px;align-items:center;padding-top:14px;padding-bottom:14px}
.logo{display:block;height:96px;width:auto;background:#fff;border-radius:10px}
.titulo{border-left:1px solid var(--line);padding-left:22px;min-width:0}
.sistema{font-size:14px;font-weight:600;color:var(--rey)}
.ruta{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:2px}
.ruta h1{font-family:var(--f-titulo);font-weight:800;font-style:italic;font-size:clamp(28px,4vw,42px);line-height:1.08;color:var(--tinta-marca);letter-spacing:-.01em}
.ruta h1 .sep{display:inline-block;width:.75em;height:5px;background:var(--cielo);vertical-align:middle;margin:0 .25em .14em;border-radius:3px;transform:skewX(-20deg)}
.km{border:1.5px solid var(--line);color:var(--mute);border-radius:4px;padding:2px 8px 0;font-weight:600;font-size:13.5px}
.fecha{margin-top:4px;color:var(--mute);font-size:14.5px}
.reloj{display:flex;flex-direction:column;align-items:flex-end;gap:5px}
.reloj .hora{font-family:var(--f-titulo);font-weight:800;font-size:clamp(32px,4.6vw,48px);line-height:1;color:var(--tinta-marca)}
.reloj .hora small{font-size:.42em;color:var(--mute);font-weight:700;margin-left:2px}
.reloj label,.reloj .sub{font-size:13px;color:var(--mute);display:flex;gap:8px;align-items:center}
.reloj input,.reloj select{background:var(--hielo);border:1px solid var(--line);color:var(--ink);border-radius:5px;padding:3px 6px 1px}
.vivo{display:inline-flex;align-items:center;gap:6px}
.vivo::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--go-dot)}
.vivo.pausa::before{background:var(--gris-dot)}
@media (prefers-reduced-motion:no-preference){.vivo:not(.pausa)::before{animation:late 1.6s ease-in-out infinite}@keyframes late{50%{opacity:.25}}}
.franja{display:grid;grid-template-columns:7fr 3fr;height:5px}
.franja i:nth-child(1){background:#0959C9} .franja i:nth-child(2){background:#1BACE5}
.resumen{background:var(--banda);color:var(--banda-ink)}
.estado-dia{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.estado-dia > div{padding:12px 16px 13px 0}
.estado-dia > div + div{border-left:1px solid rgba(255,255,255,.14);padding-left:16px}
.estado-dia h2{font-size:13px;font-weight:600;color:var(--banda-mute)}
.estado-dia p{font-size:15px;margin-top:3px}
.estado-dia b{font-family:var(--f-titulo);font-weight:800}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin:0 5px 1px 0;vertical-align:middle}
.d-ok{background:#3DBE73}.d-medir{background:#F2B33D}.d-no{background:#F0645A}.d-gris{background:#8090A6}
@media (max-width:720px){
  .cab-in{grid-template-columns:auto 1fr;gap:10px 14px;padding-top:10px;padding-bottom:12px}
  .logo{height:62px}
  .titulo{grid-column:1/-1;grid-row:2;border-left:0;padding-left:0}
  .reloj{justify-self:end;grid-column:2;grid-row:1}
  .estado-dia{grid-template-columns:1fr 1fr}
  .estado-dia > div{padding:9px 10px 10px 0}
  .estado-dia > div + div{border-left:0;padding-left:0}
  .estado-dia p{font-size:13.5px}
  .tabs-bar{position:static}
  .acciones .largo{display:none}
  .acciones .corto{display:inline}
}
.demo{background:var(--warn-bg);color:var(--warn);font-size:13.5px;border-bottom:1px solid var(--line)}
.demo .wrap{padding-top:7px;padding-bottom:6px}

/* Pie */
.pie{background:var(--card);border-top:1px solid var(--line)}
.pie-in{display:flex;gap:16px;align-items:center;padding-top:18px;padding-bottom:22px;flex-wrap:wrap}
.logo-pie{height:54px;width:auto;border-radius:6px;background:#fff;border:1px solid var(--line-2)}
.lema{font-family:var(--f-titulo);font-weight:800;font-style:italic;color:var(--rey);font-size:15px}
.pie .sub{max-width:86ch;color:var(--mute);font-size:13px}

@media print{
  .tabs-bar .acciones,.demo,.velo,.drawer,.toast,.reloj label,.filtros .buscar,.tip{display:none!important}
  .tabs-bar{position:static}
  body{background:#fff}
  .resumen,.franja,.pill,.bus,.ll{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .bus,.panel,.kpi{break-inside:avoid}
}

/* Pestañas */
.tabs-bar{background:var(--card);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:5}
.tabs-bar .wrap{display:flex;align-items:center;gap:12px;justify-content:space-between;flex-wrap:wrap}
.tabs{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;margin:0 -16px;padding:0 16px}
.tabs::-webkit-scrollbar{display:none}
.tab{background:none;border:0;border-bottom:3px solid transparent;padding:13px 12px 9px;font-weight:600;color:var(--mute);white-space:nowrap}
.tab[aria-selected="true"]{color:var(--tinta-marca);border-bottom-color:var(--rey)}
.tab .n{font-weight:400;color:var(--mute);margin-left:4px}
.tab .n.alto{color:var(--stop);font-weight:800}
.acciones{display:flex;gap:6px;padding:6px 0;flex-wrap:wrap}
.btn{border:1px solid var(--line);background:var(--card);border-radius:6px;padding:6px 11px 4px;font-size:14px;font-weight:600}
.btn:hover{border-color:var(--mute)}
.btn-pri{background:var(--rey);border-color:var(--rey);color:#fff}
.btn-pri:hover{background:var(--marino);border-color:var(--marino)}
.btn-sm{padding:4px 9px 2px;font-size:13px}
.btn[disabled]{opacity:.5;cursor:default}
.corto{display:none}
.btn-link{border:0;background:none;color:var(--info);padding:0;font-weight:600;text-decoration:underline;text-underline-offset:2px}
a{color:var(--info)}

main{padding:24px 0 48px}
.intro{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:14px}
.intro h2{font-family:var(--f-titulo);font-size:22px;font-weight:800;color:var(--tinta-marca)}
.intro p{color:var(--mute);max-width:78ch}
.filtros{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:4px 0 18px}
.chip{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:5px 12px 3px;font-size:14px;font-weight:600;color:var(--mute)}
.chip[aria-pressed="true"]{background:var(--activo);border-color:var(--activo);color:#fff}
.buscar{margin-left:auto;min-width:220px;flex:0 1 280px;border:1px solid var(--line);background:var(--card);border-radius:6px;padding:7px 10px 5px}
@media (max-width:640px){.buscar{margin-left:0;flex:1 1 100%}}
.leyenda{display:flex;gap:16px;flex-wrap:wrap;font-size:13px;color:var(--mute);margin:0 0 12px}
.leyenda span{display:inline-flex;align-items:center;gap:6px}
.sw{display:inline-block;width:10px;height:16px;border-radius:2px}
.sw.v{background:var(--go-dot)} .sw.a{background:var(--warn-dot)} .sw.r{background:var(--stop-dot)} .sw.g{background:var(--gris-dot)}
.sw.n{border:1px dashed var(--mute)}

/* Grupos y tarjetas de bus */
.grupo{margin-bottom:26px}
.grupo h3{font-size:15px;font-weight:800;margin-bottom:10px;display:flex;align-items:center;gap:2px}
.grupo h3 .c{font-weight:400;color:var(--mute);margin-left:6px}
.grid-buses{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}
.bus{display:flex;flex-direction:column;gap:9px;text-align:left;border:1px solid var(--line);border-left:5px solid var(--go-dot);
  background:var(--card);border-radius:8px;padding:12px 12px 11px;box-shadow:var(--shadow);min-width:0}
.bus:hover{border-color:var(--mute)}
.bus.e-amarillo{border-left-color:var(--warn-dot)}
.bus.e-rojo{border-left-color:var(--stop-dot)}
.bus.e-gris{border-left-color:var(--gris-dot)}
.bus-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.bus-top .placa{flex:0 0 auto}
.placa{display:inline-flex;flex-direction:column;background:var(--plate);color:var(--plate-ink);border:2px solid var(--plate-ink);
  border-radius:5px;min-width:104px;overflow:hidden;line-height:1}
.placa .pais{background:var(--plate-band);color:#fff;font-size:8.5px;font-weight:800;letter-spacing:.18em;text-align:center;padding:2px 0 1px}
.placa .num{font-weight:800;font-size:19px;letter-spacing:.06em;text-align:center;padding:5px 8px 3px;white-space:nowrap}
.placa.sm{min-width:78px;border-width:1.5px}
.placa.sm .num{font-size:14px;padding:3px 6px 2px}
.placa.sm .pais{font-size:7px}
.bus-id{text-align:right;font-size:13px;color:var(--mute)}
.bus-id b{display:block;color:var(--ink);font-size:16px}
.bus-mid{display:grid;grid-template-columns:56px 1fr;gap:12px;align-items:start}
.mini{display:block;width:56px;height:97px}
.bus-txt{display:flex;flex-direction:column;gap:3px;min-width:0}
.est{font-weight:800;font-size:15px}
.e-verde .est{color:var(--go)} .e-amarillo .est{color:var(--warn)} .e-rojo .est{color:var(--stop)} .e-gris .est{color:var(--mute)}
.op{font-size:13px;color:var(--mute)}
.razon{font-size:13.5px;color:var(--ink)}
.razon.mute{color:var(--mute);font-size:13px}
.vacio{border:1px dashed var(--line);border-radius:8px;padding:22px;color:var(--mute);text-align:center}

/* Neumáticos en SVG */
.chasis{fill:var(--hielo);stroke:var(--line);stroke-width:1.2}
.parab{fill:var(--bruma)}
.ll{stroke:var(--card);stroke-width:1}
.ll-v{fill:var(--go-dot)} .ll-a{fill:var(--warn-dot)} .ll-r{fill:var(--stop-dot)} .ll-g{fill:var(--gris-dot)}
.ll-n{fill:var(--card);stroke:var(--mute);stroke-dasharray:2.5 2;stroke-width:1}
.ll.sel{stroke:var(--ink);stroke-width:2.2}

/* Pills */
.pill{display:inline-block;border-radius:4px;padding:2px 7px 0;font-size:12.5px;font-weight:800;white-space:nowrap}
.p-ok{background:var(--go-bg);color:var(--go)} .p-obs{background:var(--warn-bg);color:var(--warn)}
.p-bloq{background:var(--stop-bg);color:var(--stop)} .p-info{background:var(--info-bg);color:var(--info)}
.p-gris{background:var(--line-2);color:var(--mute)}

/* Tablas */
.tabla{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line);border-radius:8px;overflow:hidden}
.tabla th{font-size:13px;font-weight:600;color:var(--mute);text-align:left;padding:10px 12px 8px;border-bottom:1px solid var(--line);background:var(--hielo)}
.tabla td{padding:9px 12px 7px;border-bottom:1px solid var(--line-2);vertical-align:top;font-size:14px}
.tabla tr:last-child td{border-bottom:0}
.tabla tbody tr[data-act]{cursor:pointer}
.tabla tbody tr[data-act]:hover td{background:var(--paper)}
.tabla .r{text-align:right;white-space:nowrap}
.cod{font-weight:800}
.sub{color:var(--mute);font-size:13px}
@media (max-width:760px){
  .tabla.resp thead{display:none}
  .tabla.resp, .tabla.resp tbody, .tabla.resp tr, .tabla.resp td{display:block;width:100%}
  .tabla.resp tr{border-bottom:1px solid var(--line);padding:8px 0}
  .tabla.resp td{border:0;padding:2px 12px}
  .tabla.resp td[data-l]::before{content:attr(data-l) ": ";color:var(--mute);font-size:12.5px}
  .tabla.resp .r{text-align:left}
}

/* Paneles y listas */
.dos{display:grid;grid-template-columns:1.2fr .8fr;gap:22px;align-items:start}
@media (max-width:900px){.dos{grid-template-columns:1fr}}
.panel{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:16px;box-shadow:var(--shadow);min-width:0}
.panel + .panel{margin-top:16px}
.panel h3{font-family:var(--f-titulo);font-size:16px;font-weight:700;margin-bottom:4px;color:var(--tinta-marca)}
.panel > p.sub{margin-bottom:10px}
.lista{list-style:none;margin:0;padding:0}
.lista li{display:grid;grid-template-columns:76px 1fr;gap:4px 10px;padding:10px 0 9px;border-top:1px solid var(--line-2)}
.lista li:first-child{border-top:0}
.lista .pill{align-self:start;justify-self:start}
.lista .q{font-size:13.5px;color:var(--mute);margin-top:2px}
.lista .q.ink{color:var(--ink)}
.lista .fila-acc{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px}
.subgrupo{font-size:13px;font-weight:800;color:var(--mute);margin:14px 0 2px}
.proto{display:grid;gap:8px}
.proto div{border:1px solid var(--line-2);border-radius:6px;padding:9px 11px 7px;font-size:13.5px}
.proto b{display:block;font-size:13px}

/* Indicadores */
.kpis{display:flex;flex-direction:column;gap:12px}
.kpi{display:grid;grid-template-columns:minmax(220px,320px) 1fr;gap:18px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:16px}
@media (max-width:760px){.kpi{grid-template-columns:1fr}}
.kpi h3{font-family:var(--f-titulo);font-size:15.5px;font-weight:700;color:var(--tinta-marca)}
.kpi .f{font-size:12.5px;color:var(--mute);margin-top:4px}
.kpi .v{font-family:var(--f-titulo);font-weight:800;font-size:22px;margin-top:6px}
.escala{position:relative;height:100px;margin:0 14px}
.escala .eje{position:absolute;left:0;right:0;top:34px;height:2px;background:var(--line)}
.escala .tick{position:absolute;top:80px;font-size:11px;color:var(--mute);transform:translateX(-50%);white-space:nowrap}
.escala .tick::before{content:"";position:absolute;left:50%;top:-44px;width:1px;height:6px;background:var(--line)}
.marca{position:absolute;top:27px;width:0;display:flex;flex-direction:column;align-items:center}
.marca i{display:block;flex:0 0 auto;width:16px;height:16px;border-radius:50%;border:2px solid var(--card)}
.marca span{position:absolute;bottom:22px;left:0;transform:translateX(-50%);font-size:12px;font-weight:800;white-space:nowrap}
.marca.der span{transform:translateX(-92%)}
.marca.izq span{transform:translateX(-8%)}
.m-hoy{z-index:2} .m-hoy i{background:var(--go-dot)} .m-hoy.bajo i{background:var(--stop-dot)}
.m-meta{top:19px} .m-meta i{width:3px;height:32px;border-radius:2px;background:var(--ink);border:0}
.m-meta span{bottom:auto;top:37px;font-weight:600}
.cifras{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin:16px 0}
.cifras div{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--rey);border-radius:8px;padding:12px 14px 10px}
.cifras b{display:block;font-family:var(--f-titulo);font-size:22px;font-weight:800;color:var(--tinta-marca)}
.cifras span{font-size:13px;color:var(--mute)}
.graf{display:block;width:100%;height:auto;overflow:visible}
.graf-scroll{overflow-x:auto}
.graf-scroll .graf{min-width:640px}
.graf text{font-size:11px;fill:var(--mute);font-family:"Overpass",system-ui,sans-serif}
.graf .grid{stroke:var(--line-2);stroke-width:1}
.graf .base{stroke:var(--line);stroke-width:1}
.graf .b-r{fill:var(--stop-bg)} .graf .b-a{fill:var(--warn-bg)}
.graf .umbral{stroke-width:1;stroke-dasharray:4 3}
.graf .u-r{stroke:var(--stop)} .graf .u-a{stroke:var(--warn)}
.graf .s-frio{fill:none;stroke:var(--rey);stroke-width:2;stroke-linejoin:round;stroke-linecap:round}
.graf .s-med{fill:none;stroke:var(--medida);stroke-width:1.5;stroke-linejoin:round}
.graf .s-temp{fill:none;stroke:var(--mute);stroke-width:2;stroke-linejoin:round}
.graf .cross{stroke:var(--ink);stroke-width:1;opacity:0}
.graf .barra{stroke:var(--card);stroke-width:2}
.graf .barra.v{fill:var(--go-dot)} .graf .barra.a{fill:var(--warn-dot)} .graf .barra.r{fill:var(--stop-dot)}
.leg{display:flex;gap:14px;flex-wrap:wrap;font-size:12.5px;color:var(--mute);margin:4px 0 6px}
.leg span{display:inline-flex;gap:6px;align-items:center}
.leg i{display:inline-block;width:16px;height:0;border-top:2px solid var(--rey)}
.leg i.med{border-top:1.5px solid var(--medida)} .leg i.tmp{border-top-color:var(--mute)}
.leg i.zr{height:10px;border:0;background:var(--stop-bg);width:12px} .leg i.za{height:10px;border:0;background:var(--warn-bg);width:12px}
.tip{position:fixed;z-index:40;pointer-events:none;background:var(--ink);color:var(--paper);font-size:12.5px;line-height:1.4;padding:7px 10px 5px;border-radius:6px;max-width:280px;box-shadow:0 4px 14px rgba(6,24,72,.25)}

/* Mapa */
.mapa-wrap{background:var(--card);border:1px solid var(--line);border-radius:8px;overflow-x:auto;padding:6px 6px 0}
.mapa{display:block;min-width:820px;width:100%;height:auto}
.mapa text{font-family:"Overpass",system-ui,sans-serif;fill:var(--ink)}
.mapa .t-mute{fill:var(--mute)}
