function histograma(v) {
  if (!v.length) return `<p class="vacio">No hay buses en ruta con lecturas recientes.</p>`;
  const lo = -40, hi = 30, w = 2, n = (hi - lo) / w, bins = new Array(n).fill(0);
  for (const x of v) bins[Math.max(0, Math.min(n - 1, Math.floor((x - lo) / w)))]++;
  const W = 1000, H = 250, L = 40, Rr = 28, T = 26, B = 28, mx = Math.max(...bins);
  const paso = [1, 2, 5, 10, 20, 25, 50, 100].find((x) => x * 4 >= mx) || 100, yM = paso * 4;
  const X = (p) => L + (p - lo) / (hi - lo) * (W - L - Rr), Y = (c) => T + (1 - c / yM) * (H - T - B);
  let s = `<svg class="graf" viewBox="0 0 ${W} ${H}" role="img" aria-label="Histograma del margen frente al límite de control de ${v.length} ruedas">`;
  for (let g = 0; g <= yM; g += paso) s += `<line class="grid" x1="${L}" x2="${W - Rr}" y1="${Y(g)}" y2="${Y(g)}"/><text x="${L - 6}" y="${Y(g) + 4}" text-anchor="end">${g}</text>`;
  bins.forEach((c, i) => {
    if (!c) return;
    const a = lo + i * w, cls = a >= 0 ? "a" : "v", x = X(a) + 1, bw = X(a + w) - X(a) - 2, y = Y(c);
    const h = Y(0) - y, r = Math.min(3, h, bw / 2);
    const rango = i === 0 ? `${a + w} °C o menos` : i === n - 1 ? `${a} °C o más` : `${a} a ${a + w} °C`;
    s += `<path class="barra ${cls}" d="M${x},${Y(0)} V${y + r} Q${x},${y} ${x + r},${y} H${x + bw - r} Q${x + bw},${y} ${x + bw},${y + r} V${Y(0)} Z" data-tip="${rango} frente al límite: ${c} rueda${c > 1 ? "s" : ""}"/>`;
  });
  s += `<line class="base" x1="${L}" x2="${W - Rr}" y1="${Y(0)}" y2="${Y(0)}"/>`;
  s += `<line class="umbral u-a" x1="${X(0)}" x2="${X(0)}" y1="${T - 6}" y2="${Y(0)}"/><text x="${X(0)}" y="${T - 10}" text-anchor="middle">límite de control</text>`;
  for (let p = lo; p <= hi; p += 10) s += `<text x="${X(p)}" y="${H - 10}" text-anchor="middle">${p > 0 ? "+" : ""}${p} °C</text>`;
  return s + `</svg>`;
}

