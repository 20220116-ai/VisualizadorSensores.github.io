  if (malos.length > 3) lineas += `<span class="razon mute">${malos.length - 3} rueda(s) más</span>`;
  if (col === "verde") { const mx = maxT(b), md = maxD(b); lineas += `<span class="razon mute">Máx. ${fT(mx)}${md != null ? " · ΔT máx. " + fT(md) : ""}</span>`; }
