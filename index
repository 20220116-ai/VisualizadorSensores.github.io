/* ---------- Datos reales: servicio web o archivo ---------- */
function ingerir(j) {
  const cero = new Date(HOY.getFullYear(), HOY.getMonth(), HOY.getDate()).getTime();
  const grupos = new Map();
  const add = (x, pos, val) => {
    const b = BUS[x.bus] || BUSES.find((y) => y.placa === x.bus || y.placa === x.placa);
    if (!b) return;
    const d = new Date(x.fecha_hora); if (isNaN(d)) return;
    const s = Math.floor((d.getTime() - cero) / 1000), m = Math.floor(s / 60);
    if (m < -1440 || m > 1439) return;
    const k = b.cod + "|" + m;
    if (!grupos.has(k)) grupos.set(k, {b, m, s, x, v: {}});
    if (pos && val != null) grupos.get(k).v[pos] = val;
  };
  const leerVal = (t, code) => { const c = code != null ? +code : null; if (c && ERR[c]) return {err: c}; return t == null || isNaN(+t) ? null : Math.round(+t * 10) / 10; };
  for (const x of (j.lecturas || (Array.isArray(j) ? j : []))) {
    const pc = String(x.posicion || "").toUpperCase(), pos = ALIAS[pc] || pc;
    if (!PI[pos]) { add(x, null, null); continue; }
    add(x, pos, leerVal(x.temperatura_c, x.codigo_error));
  }
  for (const x of (j.registros || [])) for (const p of POS) {
    const raw = x["io" + p.io];
    if (raw == null) continue;
    add(x, p.id, ERR[+raw] ? {err: +raw} : Math.round(+raw) / 10);
  }
  let n = 0;
  for (const g of [...grupos.values()].sort((a, c) => a.s - c.s)) {
    const {b, m, s, x} = g;
    if (x.lat != null && x.lon != null && (!b.ult || m >= b.ult.m)) {
      const km = kmDe(+x.lat, +x.lon), prevKm = b.op.km, enc = x.encendido !== false, vel = Math.round(+x.velocidad_kmh || 0);
      const dir = prevKm != null && Math.abs(km - prevKm) > 0.05 ? (km > prevKm ? 1 : -1) : (b.op.dir || 1);
      const term = km < 1.5 ? "Lima" : km > KM - 1.5 ? "Mala" : null;
      b.op = {e: !enc ? "apagado" : vel > 3 ? "ruta" : term ? "terminal" : "parado", enc, vel, km, dir, to: dir > 0 ? "Mala" : "Lima", donde: term || (km < KM / 2 ? "Lima" : "Mala"), lat: +x.lat, lon: +x.lon};
      b.ult = {m, s};
      if (enc && b.encDesde < m - 1440) b.encDesde = m;
    }
    if (!Object.keys(g.v).length) continue;
    recibir(b, {m, s, v: g.v}, Math.max(s, Math.floor(C.sec)));
    n += Object.values(g.v).filter((v) => typeof v === "number").length;
  }
  return n;
}
function revisarReal() {
